# Strat9-OS minimal U-Boot config for x86_64 QEMU
# Based on qemu-x86_64_defconfig, stripped to essentials

CONFIG_TARGET_QEMU_X86_64=y

# Boot
CONFIG_BOOTM=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_ELF=y
CONFIG_CMD_RUN=y
CONFIG_CMD_SOURCE=y

# Filesystem (for loading kernel and modules)
CONFIG_FS_FAT=y
CONFIG_FS_EXT4=y
CONFIG_CMD_FAT=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_LS=y
CONFIG_CMD_LOAD=y
CONFIG_CMD_CAT=y

# Serial console
CONFIG_SERIAL=y
CONFIG_DM_SERIAL=y
CONFIG_SYS_NS16550=y
CONFIG_SYS_NS16550_PORT_MAPPED=y

# Basic hardware
CONFIG_TIMER=y
CONFIG_CMD_TIMER=y
CONFIG_CMD_DATE=y

# Environment
CONFIG_ENV_IS_NOWHERE=y
CONFIG_ENV_IS_IN_FAT=y
CONFIG_ENV_FAT_INTERFACE="virtio"
CONFIG_ENV_FAT_DEVICE_AND_PART="0:1"
CONFIG_ENV_FAT_FILE="uboot.env"
CONFIG_FAT_WRITE=y

